{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jorgelsa89/research-os-mobile-brief/claude/ai-assistant-device-button-tz69jj/server/observation.schema.json",
  "title": "Observation — fuente voice-button, contrato v0",
  "description": "Payload de POST /observations. Propiedad compartida entre los dos agentes; se cambia por commit junto a PARA-CODEX.md y contract-test.mjs.",
  "type": "object",
  "required": ["id", "source", "vault_id", "captured_at"],
  "anyOf": [
    { "required": ["transcript"] },
    { "required": ["audio_ref"] }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID (Crockford base32) generado al pulsar el botón. Clave de idempotencia: el mismo id nunca crea dos registros."
    },
    "source": { "const": "voice-button" },
    "vault_id": {
      "type": "string",
      "description": "Bóveda destino. Durante el piloto siempre 'personal'."
    },
    "captured_at": { "type": "string", "format": "date-time" },
    "location": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "accuracy_m": { "type": "number", "minimum": 0 }
      }
    },
    "audio_ref": {
      "type": "string",
      "description": "Referencia al audio dentro de la bóveda (vault://...). Nunca el binario."
    },
    "transcript": { "type": "string" },
    "stt": {
      "type": "object",
      "required": ["engine", "model"],
      "properties": {
        "engine": { "type": "string" },
        "model": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "intent": {
      "type": "object",
      "required": ["tool"],
      "properties": {
        "tool": { "type": "string" },
        "args": { "type": "object" }
      }
    }
  }
}
